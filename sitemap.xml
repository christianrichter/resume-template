---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.html_pages %}
  <url>
    <loc>{{ p.url | replace:'index.html','' | replace:'.html','' | prepend: site.baseurl | prepend: site.url }}</loc>
    {%- if p.last_modified_at %}
    <lastmod>{{ p.last_modified_at | date: '%Y-%m-%d' }}</lastmod>
    {%- endif %}
  </url>
{%- endfor %}
</urlset>
